{
  "name": "owlwarden",
  "version": "1.2.0",
  "description": "Offline security scanner for Node web apps and AI coding agents. OWASP rules with framework-specific fixes for 12 stacks, plus .claude/.cursor/.vscode config scanning. No telemetry.",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suthat/owlwarden.git",
    "directory": "packages/cli"
  },
  "homepage": "https://suthat.github.io/owlwarden",
  "keywords": [
    "security",
    "security-scanner",
    "sast",
    "static-analysis",
    "vulnerability-scanner",
    "owasp",
    "owasp-top-10",
    "appsec",
    "devsecops",
    "code-security",
    "nodejs",
    "typescript",
    "nextjs",
    "nuxt",
    "nestjs",
    "express",
    "fastify",
    "hono",
    "npm-security",
    "supply-chain-security",
    "dependency-scanner",
    "osv",
    "sarif",
    "ai-security",
    "agent-security",
    "claude-code",
    "cursor",
    "mcp",
    "mcp-server",
    "vibe-coding",
    "ai-code-review",
    "prompt-injection",
    "secure-by-default",
    "cli"
  ],
  "type": "module",
  "bin": {
    "owlwarden": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@dointhai/owlwarden-config": "workspace:*",
    "@dointhai/owlwarden-core-native": "workspace:*",
    "@dointhai/owlwarden-sdk": "workspace:*"
  },
  "funding": "https://github.com/sponsors/suthat",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
