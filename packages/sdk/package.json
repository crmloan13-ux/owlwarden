{
  "name": "@dointhai/owlwarden-sdk",
  "version": "1.3.0",
  "description": "Types and zod schemas for owlwarden reports, rules, and coverage. Install `owlwarden` to run the scanner.",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suthat/owlwarden.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "homepage": "https://suthat.github.io/owlwarden",
  "funding": "https://github.com/sponsors/suthat",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "owlwarden",
    "security",
    "sast",
    "internal"
  ]
}
