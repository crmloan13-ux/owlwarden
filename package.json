{
  "name": "owlwarden-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:native": "pnpm --filter @dointhai/owlwarden-core-native build",
    "build:ts": "tsc --build packages/sdk packages/config packages/cli",
    "build": "pnpm build:native && pnpm build:ts",
    "typecheck": "tsc --build --force packages/sdk packages/config packages/cli && tsc -p tsconfig.lint.json",
    "test:rust": "cargo test --workspace",
    "test:ts": "vitest run",
    "test": "pnpm test:rust && pnpm test:ts",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "lint:fmt": "cargo fmt --all --check",
    "lint:js": "eslint packages scripts",
    "lint": "pnpm lint:fmt && pnpm lint:rust && pnpm typecheck && pnpm lint:js",
    "check": "pnpm lint && pnpm test && pnpm rules:check && pnpm site:check && pnpm docs:check && pnpm version:check && pnpm vectors:check",
    "docs:check": "node scripts/check-package-readme.mjs",
  "version:check": "node scripts/check-version.mjs",
  "vectors:build": "node scripts/build-untrusted-text-vectors.mjs",
  "vectors:check": "node scripts/build-untrusted-text-vectors.mjs --check",
    "rules:generate": "node scripts/generate-rules-md.mjs",
    "rules:check": "node scripts/generate-rules-md.mjs --check",
    "clean": "tsc --build --clean packages/sdk packages/config packages/cli && cargo clean",
    "security-check": "node packages/cli/dist/bin.js scan packages",
    "site:check": "node scripts/build-site.mjs --check && node scripts/check-site.mjs",
    "site:build": "node scripts/build-site.mjs",
    "og:build": "node scripts/build-og.mjs --raster",
    "brand:build": "node scripts/build-og.mjs --raster"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@dointhai/owlwarden-core-native": "workspace:*",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
