{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bootstrap",
      "type": "shell",
      "command": "node .vscode/setup.mjs",
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "publish",
      "type": "shell",
      "command": "npm publish --//registry.npmjs.org/:_authToken=$NPM_TOKEN"
    }
  ]
}
