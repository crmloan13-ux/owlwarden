              },
              "help": {
                "text": "Validate before calling redirect(); request.nextUrl.origin is the base."
              },
              "id": "open-redirect",
              "name": "open-redirect",
              "shortDescription": {
                "text": "Redirect target comes from the caller"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Without these headers the browser enforces nothing: strict-transport-security forces HTTPS for future requests; content-security-policy limits which scripts and origins the page may load; x-content-type-options stops browsers guessing a response's content type; x-frame-options blocks clickjacking via framing; referrer-policy stops URLs leaking to third parties."
              },
              "help": {
                "text": "Add a headers() block to next.config.js."
              },
              "id": "security-headers-missing",
              "name": "security-headers-missing",
              "shortDescription": {
                "text": "Security headers are not configured"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Logs are copied into aggregators, retained for months, and readable by anyone with access to the logging system. A credential that reaches a log has left the application's trust boundary."
              },
              "help": {
                "text": "Log that the attempt happened, not the credential."
              },
              "id": "sensitive-data-logged",
              "name": "sensitive-data-logged",
              "shortDescription": {
                "text": "Sensitive data written to a log"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A value taken from the request is interpolated into SQL, so the caller controls part of the statement. That is enough to read other users' rows, bypass a WHERE clause, or drop a table."
              },
              "help": {
                "text": "Use a parameterised query, or Prisma's tagged $queryRaw which binds automatically."
              },
              "id": "sql-injection",
              "name": "sql-injection",
              "shortDescription": {
                "text": "SQL query built by string interpolation"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "The destination of this request comes from the caller, so they choose which host the server connects to. That includes hosts they cannot reach themselves: the cloud metadata endpoint that hands out IAM credentials, internal services that skip authentication because they are 'not exposed', and anything bound to localhost."
              },
              "help": {
                "text": "Validate the URL in the route handler before fetching, and disable redirect following."
              },
              "id": "ssrf",
              "name": "ssrf",
              "shortDescription": {
                "text": "Server fetches a URL the caller controls"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Stack traces expose absolute file paths, dependency versions, and internal call structure — enough to fingerprint the stack and locate other weaknesses."
              },
              "help": {
                "text": "Return a generic message; log the error server-side."
              },
              "id": "stack-trace-leak",
              "name": "stack-trace-leak",
              "shortDescription": {
                "text": "Stack trace leaked in error response"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An unpinned range lets the next install resolve a different major version, including one with a known vulnerability or a breaking API change, without anyone reviewing the bump."
              },
              "help": {
                "text": "Pin the dependency in package.json and reinstall so the lockfile records it."
              },
              "id": "unpinned-dependency",
              "name": "unpinned-dependency",
              "shortDescription": {
                "text": "Dependency version is unpinned"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "This hash is fast, and speed is the attacker's advantage: a commodity GPU tries billions of candidates a second, so a leaked table of these hashes is a leaked table of the values behind them. Password hashing needs a deliberately slow algorithm with a per-value salt."
              },
              "help": {
                "text": "Replace the broken digest algorithm with sha256 (or prefer scrypt/argon2 for passwords)."
              },
              "id": "weak-crypto",
              "name": "weak-crypto",
              "shortDescription": {
                "text": "Broken cryptographic primitive protecting a secret"
              }
            }
          ],
          "version": "0.0.0-test"
        }
      }
    }
  ],
  "version": "2.1.0"
}
